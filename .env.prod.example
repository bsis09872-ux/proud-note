# 서버에서 .env.prod 로 복사 후 값 채우기 (커밋 금지)
APP_ENV=prod
LOG_LEVEL=INFO

# Supabase > Connect > Session pooler 주소 (IPv4 지원)
#   postgresql://... 를 postgresql+asyncpg://... 로 바꾸기
#   비밀번호에 특수문자가 있으면 URL 인코딩 (@ -> %40, # -> %23)
DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DB_SSL=true
# Transaction pooler(6543 포트)를 쓸 때만 true
DB_USE_POOLER=false
# Supabase 무료 플랜 커넥션 한도가 작으니 풀을 줄인다
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# python3 -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=60

CORS_ORIGINS=["http://localhost:3000"]
